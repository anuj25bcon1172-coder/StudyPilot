{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student workspace profile, gamification XP/level, streak, and learning path progress.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "level": {
          "type": "integer"
        },
        "xp": {
          "type": "integer"
        },
        "streakDays": {
          "type": "integer"
        },
        "languageTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "algebraProgress": {
          "type": "integer"
        },
        "linearProgress": {
          "type": "integer"
        },
        "quadraticProgress": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "level",
        "xp",
        "streakDays",
        "languageTarget",
        "algebraProgress",
        "linearProgress",
        "quadraticProgress",
        "updatedAt"
      ]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Student academic assignment with subject, due date, and status.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Completed", "Overdue"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "subject", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Daily study goal checklist item.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "completed", "createdAt", "updatedAt"]
    },
    "TimelineEvent": {
      "title": "TimelineEvent",
      "description": "Scheduled study session or reminder on the dashboard timeline.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "colorTheme": {
          "type": "string",
          "enum": ["rose", "emerald", "purple"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "time", "date", "colorTheme", "createdAt"]
    },
    "SavedSolution": {
      "title": "SavedSolution",
      "description": "Saved step-by-step solution generated by the AI Assignment Solver.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "finalAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "steps": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "question", "subject", "finalAnswer", "steps", "createdAt"]
    },
    "RevisionItem": {
      "title": "RevisionItem",
      "description": "Saved quick revision asset (notes, important questions, MCQ quiz, flashcards, or 5-minute summary).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toolType": {
          "type": "string",
          "enum": ["notes", "questions", "mcq", "flashcards", "summary"]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summaryText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "toolType", "topic", "summaryText", "items", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student profile and study progress metrics (no PII stored)."
    },
    "/users/{userId}/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Assignments belonging to the student."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "Today's goals checklist items belonging to the student."
    },
    "/users/{userId}/timelineEvents/{eventId}": {
      "schema": { "$ref": "#/entities/TimelineEvent" },
      "description": "Timeline schedule entries belonging to the student."
    },
    "/users/{userId}/savedSolutions/{solutionId}": {
      "schema": { "$ref": "#/entities/SavedSolution" },
      "description": "Saved AI Assignment Solver answers belonging to the student."
    },
    "/users/{userId}/revisionItems/{itemId}": {
      "schema": { "$ref": "#/entities/RevisionItem" },
      "description": "Saved Quick Revision Centre study decks and summaries."
    }
  }
}
