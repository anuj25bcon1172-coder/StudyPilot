rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Core identity and static validation primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'level', 'xp', 'streakDays',
          'languageTarget', 'algebraProgress', 'linearProgress', 'quadraticProgress', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'level', 'xp', 'streakDays',
          'languageTarget', 'algebraProgress', 'linearProgress', 'quadraticProgress', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.level is int && data.level >= 1 && data.level <= 500 &&
        data.xp is int && data.xp >= 0 && data.xp <= 1000000 &&
        data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650 &&
        data.languageTarget is string && data.languageTarget.size() >= 1 && data.languageTarget.size() <= 60 &&
        data.algebraProgress is int && data.algebraProgress >= 0 && data.algebraProgress <= 100 &&
        data.linearProgress is int && data.linearProgress >= 0 && data.linearProgress <= 100 &&
        data.quadraticProgress is int && data.quadraticProgress >= 0 && data.quadraticProgress <= 100 &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Assignment
    function isValidAssignment(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'subject', 'dueDate', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'subject', 'dueDate', 'status', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
        isValidDateString(data.dueDate) &&
        data.status in ['Pending', 'Completed', 'Overdue'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Goal
    function isValidGoal(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'completed', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.completed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: TimelineEvent
    function isValidTimelineEvent(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'time', 'date', 'colorTheme', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'time', 'date', 'colorTheme', 'createdAt']) &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 20 &&
        isValidDateString(data.date) &&
        data.colorTheme in ['rose', 'emerald', 'purple'] &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: SavedSolution
    function isValidSavedSolution(data, userId) {
      return data.keys().hasAll(['userId', 'question', 'subject', 'finalAnswer', 'steps', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'question', 'subject', 'finalAnswer', 'steps', 'createdAt']) &&
        data.userId is string && data.userId == userId &&
        data.question is string && data.question.size() >= 1 && data.question.size() <= 4000 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
        data.finalAnswer is string && data.finalAnswer.size() >= 1 && data.finalAnswer.size() <= 2000 &&
        data.steps is list && data.steps.size() >= 1 && data.steps.size() <= 15 &&
        data.steps[0] is map &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: RevisionItem
    function isValidRevisionItem(data, userId) {
      return data.keys().hasAll(['userId', 'toolType', 'topic', 'summaryText', 'items', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'toolType', 'topic', 'summaryText', 'items', 'createdAt']) &&
        data.userId is string && data.userId == userId &&
        data.toolType in ['notes', 'questions', 'mcq', 'flashcards', 'summary'] &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 160 &&
        data.summaryText is string && data.summaryText.size() >= 1 && data.summaryText.size() <= 12000 &&
        data.items is list && data.items.size() <= 30 &&
        (data.items.size() == 0 || data.items[0] is map) &&
        data.createdAt is timestamp;
    }

    // Student Profile Document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'level', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['algebraProgress', 'linearProgress', 'quadraticProgress', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['streakDays', 'languageTarget', 'displayName', 'updatedAt'])
        );
      allow delete: if false;

      // Assignments Subcollection
      match /assignments/{assignmentId} {
        allow get: if isValidId(userId) && isValidId(assignmentId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(assignmentId) &&
          isOwner(userId) &&
          isValidAssignment(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(assignmentId) &&
          isOwner(userId) &&
          isValidAssignment(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          existing().status != 'Completed' &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'dueDate', 'status', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(assignmentId) && isOwner(userId);
      }

      // Today's Goals Subcollection
      match /goals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(goalId) &&
          isOwner(userId) &&
          isValidGoal(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(goalId) &&
          isOwner(userId) &&
          isValidGoal(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(goalId) && isOwner(userId);
      }

      // Timeline Events Subcollection
      match /timelineEvents/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(eventId) &&
          isOwner(userId) &&
          isValidTimelineEvent(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(eventId) && isOwner(userId);
      }

      // Saved AI Solutions Subcollection
      match /savedSolutions/{solutionId} {
        allow get: if isValidId(userId) && isValidId(solutionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(solutionId) &&
          isOwner(userId) &&
          isValidSavedSolution(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(solutionId) && isOwner(userId);
      }

      // Quick Revision Centre Items Subcollection
      match /revisionItems/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(itemId) &&
          isOwner(userId) &&
          isValidRevisionItem(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }
    }
  }
}
