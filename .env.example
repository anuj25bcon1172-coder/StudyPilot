# Gemini AI API Key (Server-side only; automatically injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Configuration (Used when firebase-applet-config.json is not present)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
# Firestore custom database ID
VITE_FIREBASE_DATABASE_ID="MY_FIRESTORE_DATABASE_ID"
